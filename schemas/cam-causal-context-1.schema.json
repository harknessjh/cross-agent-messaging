{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright © 2026 John Harkness. Licensed under the PolyForm Noncommercial License 1.0.0; see LICENSE.",
  "title": "CAM journal-bound causal context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "conversation_id",
    "depends_on",
    "supersedes",
    "recipient_frontier"
  ],
  "properties": {
    "format": { "const": "CAM-CAUSAL/1" },
    "conversation_id": { "$ref": "#/$defs/uuid" },
    "depends_on": { "$ref": "#/$defs/uuidArray" },
    "supersedes": { "$ref": "#/$defs/uuidArray" },
    "recipient_frontier": { "$ref": "#/$defs/uuidArray" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuidArray": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    }
  }
}
