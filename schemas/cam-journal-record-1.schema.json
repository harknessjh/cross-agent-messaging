{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright © 2026 John Harkness. Licensed under the PolyForm Noncommercial License 1.0.0; see LICENSE.",
  "title": "CAM required local journal record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sequence",
    "record_id",
    "project_id",
    "worktree_id",
    "recorded_at",
    "provenance",
    "event_type",
    "previous_record_sha256",
    "message",
    "attributes",
    "record_sha256"
  ],
  "properties": {
    "format": { "const": "CAM-JOURNAL/1" },
    "sequence": { "type": "integer", "minimum": 1 },
    "record_id": { "$ref": "#/$defs/uuid" },
    "project_id": { "$ref": "#/$defs/uuid" },
    "worktree_id": { "$ref": "#/$defs/uuid" },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "previous_record_sha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "message": {
      "oneOf": [
        { "$ref": "#/$defs/message" },
        { "type": "null" }
      ]
    },
    "attributes": {
      "type": "object",
      "maxProperties": 64
    },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_top_level",
        "head_sha",
        "head_tree_sha",
        "branch",
        "dirty",
        "captured_at"
      ],
      "properties": {
        "git_top_level": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "head_sha": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            { "type": "null" }
          ]
        },
        "head_tree_sha": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            { "type": "null" }
          ]
        },
        "branch": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        },
        "dirty": { "type": "boolean" },
        "captured_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "byte_length", "sha256", "content"],
      "properties": {
        "encoding": { "const": "base64" },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "content": {
          "type": "string",
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
