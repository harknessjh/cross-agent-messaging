{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright © 2026 John Harkness. Licensed under the PolyForm Noncommercial License 1.0.0; see LICENSE.",
  "title": "CAM product executable approval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "sequence", "record_id", "recorded_at", "event_type", "previous_record_sha256", "attributes", "record_sha256"],
  "properties": {
    "format": {"const": "CAM-PRODUCT-EXECUTABLE-APPROVAL/1"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 10000},
    "record_id": {"type": "string", "format": "uuid"},
    "recorded_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "event_type": {"enum": ["product_executable.approved", "product_executable.revoked", "product_executable.recovered_partial_tail"]},
    "previous_record_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "attributes": {
      "oneOf": [
        {"$ref": "#/$defs/approval"},
        {"$ref": "#/$defs/revocation"},
        {"$ref": "#/$defs/recovery"}
      ]
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vendor": {"enum": ["codex", "claude-code"]},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/",
      "$comment": "The runtime also rejects every Unicode Cc, Cf, Cs, Zl, and Zp code point; this explicit set is schema-level defense in depth.",
      "not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff]"}
    },
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:.*\\S)?$",
      "$comment": "The runtime also rejects every Unicode Cc, Cf, Cs, Zl, and Zp code point; this explicit set is schema-level defense in depth.",
      "not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff]"}
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size", "uid", "mode", "dev", "inode", "ctime_ns"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "uid": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
        "dev": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "ctime_ns": {"type": "integer", "minimum": 0}
      }
    },
    "migration": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "participant_id", "binding_generation", "source", "source_reference"],
          "properties": {
            "project_id": {"type": "string", "format": "uuid"},
            "participant_id": {"type": "string", "format": "uuid"},
            "binding_generation": {"type": "integer", "minimum": 1},
            "source": {"const": "confirmed_enrollment"},
            "source_reference": {"type": "string", "format": "uuid"}
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "canonical_path", "fingerprint", "fingerprint_sha256", "basis", "operator_reference", "migration"],
      "properties": {
        "vendor": {"$ref": "#/$defs/vendor"},
        "canonical_path": {"$ref": "#/$defs/path"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "basis": {"enum": ["operator_confirmation", "grandfathered_roster"]},
        "operator_reference": {"$ref": "#/$defs/singleLine"},
        "migration": {"$ref": "#/$defs/migration"}
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "canonical_path", "fingerprint_sha256", "approval_record_id", "operator_reference"],
      "properties": {
        "vendor": {"$ref": "#/$defs/vendor"},
        "canonical_path": {"$ref": "#/$defs/path"},
        "fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "approval_record_id": {"type": "string", "format": "uuid"},
        "operator_reference": {"$ref": "#/$defs/singleLine"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_file", "archive_sha256", "archive_byte_length", "damaged_registry_sha256", "damaged_registry_byte_length", "verified_prefix_sha256", "verified_prefix_byte_length", "verified_prefix_record_count", "verified_prefix_last_record_sha256", "partial_tail_sha256", "partial_tail_byte_length", "partial_tail_fragment_count", "reason", "operator_reference"],
      "properties": {
        "archive_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^product-executables-v1\\.damaged-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.jsonl$"
        },
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "archive_byte_length": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "damaged_registry_sha256": {"$ref": "#/$defs/sha256"},
        "damaged_registry_byte_length": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "verified_prefix_sha256": {"$ref": "#/$defs/sha256"},
        "verified_prefix_byte_length": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "verified_prefix_record_count": {"type": "integer", "minimum": 0, "maximum": 9999},
        "verified_prefix_last_record_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "partial_tail_sha256": {"$ref": "#/$defs/sha256"},
        "partial_tail_byte_length": {"type": "integer", "minimum": 1, "maximum": 32768},
        "partial_tail_fragment_count": {"const": 1},
        "reason": {"$ref": "#/$defs/singleLine"},
        "operator_reference": {"$ref": "#/$defs/singleLine"}
      }
    }
  }
}
